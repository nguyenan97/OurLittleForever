{
  "name": "our-little-forever",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.21.3",
  "scripts": {
    "media:develop": "node scripts/develop-photos.mjs",
    "media": "node scripts/prepare-media.mjs && node scripts/prepare-video.mjs && node scripts/prepare-music.mjs",
    "prestart": "npm run media",
    "start": "ng serve --host 127.0.0.1 --port 4200",
    "prebuild": "npm run media",
    "build": "ng build",
    "postbuild": "node scripts/prepare-pages.mjs",
    "build:pages": "npm run media && npm run compile:pages",
    "compile:pages": "ng build --base-href /OurLittleForever/ && node scripts/prepare-pages.mjs",
    "publish:media": "npm run media && node scripts/publish-media.mjs",
    "preview:pages": "node scripts/preview-pages.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@angular/common": "~21.2.0",
    "@angular/compiler": "~21.2.0",
    "@angular/core": "~21.2.0",
    "@angular/platform-browser": "~21.2.0",
    "@angular/router": "~21.2.0",
    "rxjs": "~7.8.2",
    "three": "0.187.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "~21.2.0",
    "@angular/cli": "~21.2.0",
    "@angular/compiler-cli": "~21.2.0",
    "@types/three": "^0.183.0",
    "sharp": "^0.34.5",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || >=24.0.0"
  }
}
